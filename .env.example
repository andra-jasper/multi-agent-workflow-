# Copy to .env and fill in your values
# LLM key for the real CrewAI backend (not needed when DRY_RUN=true)
OPENAI_API_KEY=sk-your-key-here
# Audit-trail database: PostgreSQL in production, SQLite file fallback locally
DATABASE_URL=postgresql://user:password@localhost:5432/workflows
# DRY_RUN=true -> deterministic offline stub agents; no network, no API key
DRY_RUN=true
# HUMAN_APPROVAL=prompt asks for approval on stdin before execution (default: auto)
HUMAN_APPROVAL=auto
